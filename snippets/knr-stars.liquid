{%- comment -%}
  Note sur 5 étoiles (12px), lisible par les lecteurs d'écran.
  Usage : {% render 'knr-stars', rating: 4 %}
{%- endcomment -%}
{%- assign rating_rounded = rating | round -%}
{%- assign rating_label = rating | round: 1 -%}
<span
  class="knr-stars"
  role="img"
  aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: rating_label, rating_max: 5 }}"
>
