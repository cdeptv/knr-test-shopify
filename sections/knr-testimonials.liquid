{{ 'knr-base.css' | asset_url | stylesheet_tag }}
{{ 'knr-testimonials.css' | asset_url | stylesheet_tag }}
<script src="{{ 'knr-slider.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'knr-before-after.js' | asset_url }}" defer="defer"></script>

{%- comment -%}
  Contenu propre à chaque produit, relié dans le template à des metafields produit :
  - « Témoignages » → custom.testimonial (liste de métaobjets testimonial : citation, auteur, rating)
  - « Avant / après » → custom.produit (métaobjet « produits » = comparatif avant / après : before_image, after_image)
{%- endcomment -%}
{%- liquid
  assign comparison = section.settings.comparison
  assign before_image = comparison.before_image.value.preview_image
  assign after_image = comparison.after_image.value.preview_image
  assign testimonials = section.settings.testimonials
  assign testimonial_count = testimonials.size
  assign compare_sizes = '(min-width: 990px) calc(100vw - 160px), calc(100vw - 48px)'
  assign has_compare = false
  if before_image and after_image
    assign has_compare = true
  endif
-%}

{%- if testimonial_count > 0 or has_compare -%}
<section class="knr knr-testimonials" id="KnrTestimonials-{{ section.id }}">
  {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
    <div class="knr-testimonials__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="knr-testimonials__heading knr-heading-xl">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="knr-testimonials__subheading knr-text-lead">{{ section.settings.subheading | escape | newline_to_br }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if has_compare -%}
    <knr-before-after class="knr-testimonials__compare">
      {{
        after_image
        | image_url: width: 2560
        | image_tag:
          class: 'knr-testimonials__compare-image',
          widths: '390, 780, 1280, 1920, 2560',
          sizes: compare_sizes,
          loading: 'lazy',
          alt: after_image.alt
      }}
      <div class="knr-testimonials__compare-before">
        {{
          before_image
          | image_url: width: 2560
          | image_tag:
            class: 'knr-testimonials__compare-image',
            widths: '390, 780, 1280, 1920, 2560',
            sizes: compare_sizes,
            loading: 'lazy',
            alt: before_image.alt
        }}
      </div>

      {%- if section.settings.before_label != blank -%}
        <span class="knr-testimonials__compare-label knr-testimonials__compare-label--before knr-text-label">
          {{- section.settings.before_label | escape -}}
        </span>
      {%- endif -%}
      {%- if section.settings.after_label != blank -%}
        <span class="knr-testimonials__compare-label knr-testimonials__compare-label--after knr-text-label">
          {{- section.settings.after_label | escape -}}
        </span>
      {%- endif -%}

      <input
        class="knr-testimonials__compare-range"
        type="range"
        min="0"
        max="100"
        value="50"
        aria-label="{{ 'knr.testimonials.compare_label' | t }}"
      >
      <span class="knr-testimonials__compare-divider" aria-hidden="true"></span>
      <span class="knr-testimonials__compare-handle" aria-hidden="true">
        {%- render 'knr-icon', icon: 'grip' -%}
      </span>
    </knr-before-after>
  {%- endif -%}

  {%- if testimonial_count > 0 -%}
    <knr-slider class="knr-testimonials__slider">
      <ul class="knr-testimonials__list" role="list" data-knr-slider-track>
        {%- for testimonial in testimonials -%}
          {%- liquid
            assign testimonial_rating = testimonial.rating.value
            assign testimonial_author = testimonial.auteur.value
            assign testimonial_quote = testimonial.citation.value
          -%}
          <li class="knr-testimonials__item">
            <figure class="knr-testimonials__review">
              <figcaption class="knr-testimonials__meta">
                {%- if testimonial_rating != blank -%}
                  {%- render 'knr-stars', rating: testimonial_rating -%}
                {%- endif -%}
                {%- if testimonial_author != blank -%}
                  <span class="knr-testimonials__author">{{ testimonial_author | escape }}</span>
                {%- endif -%}
              </figcaption>
              {%- if testimonial_quote != blank -%}
                <blockquote class="knr-testimonials__quote">
                  <p>{{ testimonial_quote | escape | newline_to_br }}</p>
                </blockquote>
              {%- endif -%}
            </figure>
          </li>
        {%- endfor -%}
      </ul>

      {%- if testimonial_count > 1 -%}
        <div class="knr-testimonials__nav">
          <button
            type="button"
            class="knr-testimonials__nav-button knr-testimonials__nav-button--prev"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
            data-knr-slider-prev
          >
            {%- render 'knr-icon', icon: 'chevron' -%}
          </button>
          <button
            type="button"
            class="knr-testimonials__nav-button knr-testimonials__nav-button--next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
            data-knr-slider-next
          >
            {%- render 'knr-icon', icon: 'chevron' -%}
          </button>
        </div>
      {%- endif -%}
    </knr-slider>
  {%- endif -%}
</section>
{%- endif -%}

{% schema %}
{
  "name": "KNR — Témoignages",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Sous-titre"
    },
    {
      "type": "metaobject_list",
      "id": "testimonials",
      "label": "Témoignages",
      "metaobject_type": "testimonial",
      "limit": 10,
      "info": "Relier au metafield produit « Témoignage » (custom.testimonial) pour des témoignages propres à chaque produit."
    },
    {
      "type": "header",
      "content": "Avant / après"
    },
    {
      "type": "metaobject",
      "id": "comparison",
      "label": "Images avant / après",
      "metaobject_type": "produits",
      "info": "Relier au metafield produit « Produit » (custom.produit) pour des images propres à chaque produit."
    },
    {
      "type": "text",
      "id": "before_label",
      "label": "Libellé avant"
    },
    {
      "type": "text",
      "id": "after_label",
      "label": "Libellé après"
    }
  ],
  "presets": [
    {
      "name": "KNR — Témoignages"
    }
  ]
}
{% endschema %}
