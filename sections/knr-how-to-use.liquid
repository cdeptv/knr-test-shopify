{{ 'knr-base.css' | asset_url | stylesheet_tag }}
{{ 'knr-how-to-use.css' | asset_url | stylesheet_tag }}
<script src="{{ 'knr-slider.js' | asset_url }}" defer="defer"></script>

{%- comment -%}
  Les étapes viennent de métaobjets « Étape d'utilisation »
  (how_to_step : image, titre, texte, link_label, link_url).
  Le réglage « Étapes » est relié, dans le template, au metafield produit custom.how_to_step :
  chaque produit affiche ses propres étapes, gérées depuis sa fiche dans l'admin.
{%- endcomment -%}
{%- liquid
  assign steps = section.settings.steps
  assign step_count = steps.size
-%}

{%- if step_count > 0 -%}
  <section class="knr knr-how" id="KnrHowToUse-{{ section.id }}">
    {%- if section.settings.heading != blank -%}
      <h2 class="knr-how__heading knr-heading-lg">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <knr-slider class="knr-how__slider">
      <ol class="knr-how__list knr-track" role="list" data-knr-slider-track>
        {%- for step in steps -%}
          {%- liquid
            assign step_image = step.image.value.preview_image
            assign step_title = step.titre.value
            assign step_text = step.texte.value
            assign step_link_label = step.link_label.value
            assign step_link_url = step.link_url.value
          -%}
          <li class="knr-how__step">
            <div class="knr-how__media">
              {%- if step_image -%}
                {{
                  step_image
                  | image_url: width: 1344
                  | image_tag:
                    class: 'knr-how__image',
                    widths: '255, 510, 765, 896, 1344',
                    sizes: '(min-width: 990px) calc((100vw - 96px) / 3), 255px',
                    loading: 'lazy',
                    alt: ''
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'knr-how__image knr-how__image--placeholder' }}
              {%- endif -%}
            </div>

            <div class="knr-how__details">
              <p class="knr-how__number" aria-hidden="true">
                {%- if forloop.index < 10 %}0{% endif %}{{ forloop.index -}}
              </p>
              {%- if step_title != blank -%}
                <h3 class="knr-how__title knr-heading-md">{{ step_title | escape }}</h3>
              {%- endif -%}
              {%- if step_text != blank -%}
                <p class="knr-how__text knr-text-lead">{{ step_text | escape | newline_to_br }}</p>
              {%- endif -%}
              {%- if step_link_label != blank and step_link_url != blank -%}
                <a class="knr-how__link knr-link" href="{{ step_link_url }}">
                  {{- step_link_label | escape -}}
                  {%- if step_title != blank -%}
                    <span class="visually-hidden"> : {{ step_title | escape }}</span>
                  {%- endif -%}
                </a>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ol>

      {%- if step_count > 1 -%}
        <div class="knr-progress knr-how__progress" aria-hidden="true">
          <span
            class="knr-progress__bar"
            style="--knr-slider-progress: {{ 100.0 | divided_by: step_count }}%;"
            data-knr-slider-progress
          ></span>
        </div>
      {%- endif -%}
    </knr-slider>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "KNR — How to use",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre"
    },
    {
      "type": "metaobject_list",
      "id": "steps",
      "label": "Étapes",
      "metaobject_type": "how_to_step",
      "limit": 3,
      "info": "Relier au metafield produit « Étape d'utilisation » (custom.how_to_step) pour des étapes propres à chaque produit."
    }
  ],
  "presets": [
    {
      "name": "KNR — How to use"
    }
  ]
}
{% endschema %}
